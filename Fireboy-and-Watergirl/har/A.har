            "mimeType": "application/javascript",
            "text": "// The code in the game disables console.log.\n// Back it up in case we want to log something.\nconsole.log2 = console.log;\n\n// Don't edit this in console or you'll get something very fun.\nvar GameConfig = {\n\t// Reference value of refresh rate.\n\trefreshRate: {\n\t\t// Game will be broken if actual instant FPS is higher than this, but will not if instant FPS is lower than this.\n\t\treferenceFPS: 60,\n\t\t// Appears to affect nothing.\n\t\treferenceTPS: 60,\n\t},\n\t// Adaptive tick scheduling\n\tticking: {\n\t\t// Bounds of adaptive tick rate adjustment\n\t\tminTPS: null,\n\t\tmaxTPS: null,\n\t\t// Alternative scheduling method, not as smooth as the default one.\n\t\tuseEvenTickTimeDistribution: false,\n\t\t// Do a zero-time step if a step cannot be made in the current frame.\n\t\tensureTickEveryFrame: false,\n\t\t// Replicate a bug in the previous revision. Can cause very cursed behavior.\n\t\t// For fun only. Keep false if you want the game to work properly.\n\t\tquantumEdition: false,\n\t\t// 0: Default, do unscheduled ticking for stage and scheduled ticking for physics.\n\t\t// Negative integer: Both scheduled, multiple physics ticks per stage tick,\n\t\t// Positive integer: Both scheduled, multiple stage ticks per physics ticks \n\t\tquantumFactor: 0,\n\t},\n\t// Manual zooming\n\tzooming: {\n\t\t// When the user has zoomed out manually beyond lockScale, only allow automatically returning to lockScale,\n\t\t// so the camera will not zoom further into the game unless done manually.\n\t\t// Makes it possible to always view the level fully when playing on devices with small screens.\n\t\tlockAtMinScale: true,\n\t\t// Used to determine the min scale: How full should be level fill the screen at min scale?\n\t\tminScaleRatio: 0.9,\n\t\t// Used to determine the lock scale: \n\t\tlockScaleRatio: 0.97,\n\t},\n\t// Cheating flags.\n\tcheating: {\n\t\tisInvulnerable: false,\n\t\tisFullUnlock: false,\n\t},\n};\n\n// Main enclosure for everything.\n(() => {\n\tvar storagePrefix = 'fb-forest';\n\n\tfunction startGame() {\n\t\tif('GameConfig__setOverrides' in window) {\n\t\t\twindow.GameConfig__setOverrides(GameConfig)\n\t\t}\n\t\tconsole.info(\n\t\t\t'======== START GAME ========' + '\\n' +\n\t\t\t'Reference FPS:  ' + GameConfig.refreshRate.referenceFPS + '\\n' +\n      'Reference TPS:  ' + GameConfig.refreshRate.referenceTPS + '\\n' +\n\t\t\t'Min TPS:        ' + GameConfig.ticking.minTPS + '\\n' +\n\t\t\t'Max TPS:        ' + GameConfig.ticking.maxTPS + '\\n' +\n\t\t\t'Invulnerable:   ' + (GameConfig.cheating.isInvulnerable ? 'yes' : 'no') + '\\n' +\n\t\t\t'Full unlock:    ' + (GameConfig.cheating.isFullUnlock ? 'yes' : 'no')\n\t\t);\n\t\tsetTimeout(() => main_func(), 0);\n\t}\n\n\tGameConfig.cheating.isInvulnerable = !!localStorage.getItem(storagePrefix + ':invulnerable');\n\tGameConfig.cheating.isFullUnlock = !!localStorage.getItem(storagePrefix + ':unlock');\n\n\t// The game will incorrectly slow down if current instant FPS is higher than reference FPS,\n\t// but will run normally if the current instant FPS is lower than reference FPS.\n\t// The actual FPS of the game never references the \"reference FPS\". It is solely controlled by\n\t// requestAnimationFrame, which syncs with the display fresh rate when the game is active.\n\tGameConfig.refreshRate.referenceFPS = Infinity;\n\n\t// The TPS at which the original game is designed is 60.\n\t// Overly low TPS will cause quantum tunneling,\n\t// while overly high TPS will cause lag and physics inconsistency.\n\t// The actual TPS is dependent on requestAnimationFrame, but always clamped by minTPS and maxTPS.\n\tGameConfig.refreshRate.referenceTPS = 60;\n\tGameConfig.ticking.minTPS = 50;\n\tGameConfig.ticking.maxTPS = 100;\n\n\t// Just start it, no need to measure the refresh rate (which is fragile on VRR devices).\n\t// The normal functioning of the game does not depend on any reference FPS or TPS value to match with the hardware.\n\tstartGame();\n\n\t// Crea
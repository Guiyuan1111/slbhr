{
  "name": "gy-fw",
  "private": true,
  "version": "0.3.56",
  "type": "module",
  "description": "森林冰火人联机版：服务端权威 + Phaser 3 + Colyseus。仅供两人私下游玩，禁止分发官方素材。",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "dev:client": "node scripts/sync-assets.mjs && vite",
    "dev:server": "tsx watch packages/server/src/index.ts",
    "build": "node scripts/sync-assets.mjs && vite build",
    "start": "tsx packages/server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "colyseus": "0.16.0",
    "colyseus.js": "^0.16.0",
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
